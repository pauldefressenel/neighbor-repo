{
  "expo": {
    "name": "The Neighbor",
    "slug": "the-neighbor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theneighborr.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFF2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.theneighborr.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFF2"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "cameraPermission": "The Neighbor utilise l’appareil photo pour votre selfie, d’après lequel votre avatar de voisin est dessiné.",
          "photosPermission": "The Neighbor utilise une photo de vous pour dessiner votre avatar de voisin."
        }
      ]
    ],
    "scheme": "theneighbor",
    "backgroundColor": "#FFFFF2"
  }
}
